  "snapshots": {
    "system_prompt": "You translate earthquake catalog requests into tool calls.\nCall search_events only for earthquake catalog searches. Extract only constraints\nthe user explicitly states. Use ISO 8601 datetimes with a timezone offset. Do\nnot infer coordinates for place names. Source values are uppercase PMD, USGS,\nand MANUAL; \"manual\" or \"manually entered\" means MANUAL. For a catalog search,\ncall the tool immediately without explaining your reasoning. If the request is\nnot an earthquake catalog search, answer normally and do not call a tool.",
    "tool_schema": {
      "type": "function",
      "function": {
        "name": "search_events",
        "description": "Search the earthquake event catalog when the user asks for earthquakes filtered by magnitude, source, time, coordinates, radius, or mainshock/aftershock state. Do not call this tool for general knowledge, writing, weather, or non-earthquake tasks. Domain contract 1.0; model schema 1.2.",
        "parameters": {
          "additionalProperties": false,
          "description": "Complete deterministic input surface for catalog search.\n\nRadius is geodesic distance from ``center_lon``/``center_lat`` to each\nevent point. Named-place interpretation happens before this contract.",
          "properties": {
            "min_magnitude": {
              "anyOf": [
                {
                  "maximum": 10.0,
                  "minimum": -1.0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Inclusive minimum magnitude.",
              "title": "Min Magnitude"
            },
            "max_magnitude": {
              "anyOf": [
                {
                  "maximum": 10.0,
                  "minimum": -1.0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Inclusive maximum magnitude.",
              "title": "Max Magnitude"
            },
            "source": {
              "anyOf": [
                {
                  "enum": [
                    "PMD",
                    "USGS",
                    "MANUAL"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Canonical event source. Use uppercase PMD, USGS, or MANUAL exactly. Manually entered events map to MANUAL.",
              "title": "Source"
            },
            "search": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Case-insensitive substring of event place.",
              "title": "Search"
            },
            "occurred_after": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Inclusive lower event-time bound; ISO 8601 with timezone.",
              "title": "Occurred After"
            },
            "occurred_before": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Inclusive upper event-time bound; ISO 8601 with timezone.",
              "title": "Occurred Before"
            },
            "center_lon": {
              "anyOf": [
                {
                  "maximum": 180.0,
                  "minimum": -180.0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "WGS84 longitude in decimal degrees; east is positive.",
              "title": "Center Lon"
            },
            "center_lat": {
              "anyOf": [
                {
                  "maximum": 90.0,
                  "minimum": -90.0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "WGS84 latitude in decimal degrees; north is positive.",
              "title": "Center Lat"
            },
            "radius_km": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0.0,
                  "maximum": 5000.0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Geodesic search radius in kilometers; requires center coordinates.",
              "title": "Radius Km"
            },
            "event_kind": {
              "default": "all",
              "description": "Use mainshocks or aftershocks only when explicitly requested.",
              "enum": [
                "all",
                "mainshocks",
                "aftershocks"
              ],
              "title": "Event Kind",
              "type": "string"
            },
            "limit": {
              "default": 20,
              "description": "Maximum events to return.",
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            },
            "offset": {
              "default": 0,
              "description": "Pagination offset.",
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            },
            "orderby": {
              "default": "time",
              "description": "Sort order: time is newest first, time-asc is oldest first, and magnitude is largest first.",
              "enum": [
                "time",
                "time-asc",
                "magnitude"
              ],
              "title": "Orderby",
              "type": "string"
            }
          },
          "title": "EventSearchSpec",
          "type": "object"
        }
      }
