{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "web",
  "rewrites": [
    { "source": "/events/:path*", "destination": "https://eqmon-api.onrender.com/events/:path*" },
    { "source": "/intensity/:path*", "destination": "https://eqmon-api.onrender.com/intensity/:path*" },
    { "source": "/zones", "destination": "https://eqmon-api.onrender.com/zones" },
    { "source": "/analytics", "destination": "https://eqmon-api.onrender.com/analytics" },
    { "source": "/aftershock", "destination": "https://eqmon-api.onrender.com/aftershock" },
    { "source": "/buildings/:path*", "destination": "https://eqmon-api.onrender.com/buildings/:path*" },
    { "source": "/exposure/:path*", "destination": "https://eqmon-api.onrender.com/exposure/:path*" },
    { "source": "/ai/:path*", "destination": "https://eqmon-api.onrender.com/ai/:path*" },

    { "source": "/tiles/:path*", "destination": "https://REPLACE-WITH-R2-PUBLIC-URL.r2.dev/tiles/:path*" },
    { "source": "/pga/:path*", "destination": "https://REPLACE-WITH-R2-PUBLIC-URL.r2.dev/pga/:path*" },
    { "source": "/landslides/:path*", "destination": "https://REPLACE-WITH-R2-PUBLIC-URL.r2.dev/landslides/:path*" }
  ]
}
